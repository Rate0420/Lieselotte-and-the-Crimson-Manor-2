.debug-root {
    flex-grow: 1;
    padding: 12px;
}
.heading {
    font-size: 16px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}
.weapon-choice {
    margin-top: 10px;
}
.weapon-icon {
    width: 64px;
    height: 64px;
    margin: 8px 0;
}
.section-heading {
    -unity-font-style: bold;
    margin-bottom: 6px;
}
.enchantment-row {
    flex-direction: row;
    margin-bottom: 6px;
}
.enchantment-choice {
    flex-grow: 1;
}
.enchantment-choice > .unity-base-field__label,
.weapon-choice > .unity-base-field__label {
    min-width: 50px;
    width: 50px;
}
.enchantment-level {
    width: 100px;
    margin-left: 8px;
}
.enchantment-level > .unity-base-field__label {
    min-width: 24px;
    width: 24px;
}
.add-button {
    height: 30px;
    margin-top: 10px;
    margin-bottom: 8px;
}
.is-hidden {
    display: none;
}
