  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  text:
  - "\u3093\uFF1F\u4EBA\u5F71...\u304A\u3044\u305D\u3053\u306E\uFF01\u751F\u304D\u3066\u3044\u308B\u304B\uFF1F"
  - "\u4EBA\u5F71\u306F\u5C11\u3057\u53CD\u5FDC\u3092\u3057\u3066\u3053\u3061\u3089\u306B\u6C17\u3065\u3044\u305F\u304B\u3068\u601D\u3048\u3070\u3001\\n\u7A81\u5982\u72FC\u306E\u3088\u3046\u306A\u5486\u54EE\u3092\u4E0A\u3052\u305F\u3002"
  - "\u3086\u3063\u304F\u308A\u3068\u30BD\u30EC\u306F\u8FD1\u3065\u3044\u3066\u304F\u308B\u3002\\n\u6708\u660E\u304B\u308A\u306B\u7167\u3089\u3055\u308C\u305F\u30BD\u30EC\u306F\u3001\u4EBA\u9593\u3067\u306F\u306A\u304F\u3001\u72FC\u306B\u8FD1\u304B\u3063\u305F\u3002"
  - "\u306A\u3001\u306A\u3093\u3060\u3053\u3044\u3064\u306F\uFF01\u72FC\u4EBA\u9593\u304B\uFF01\uFF1F"
  - "\u30B6\u30B7\u30E5\u30C3\uFF01\\n\u7A81\u5982\u72FC\u4EBA\u306F\u98DB\u3073\u639B\u304B\u3063\u3066\u653B\u6483\u3057\u3066\u304D\u305F\u3002"
  - "\u3046\u304A\u3063\uFF01\uFF1F"
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6\u306F\u9593\u4E00\u9AEA\u3067\u907F\u3051\u305F\u3002"
  - "...\u3048\u3048\u3044\uFF01\u9A0E\u58EB\u3092\u8210\u3081\u308B\u306A\uFF01"
  - "\u7D20\u624B\u306E\u76F8\u624B\u3001\\n\u307E\u3057\u3066\u3084\u72AC\u755C\u751F\u306B\u8CA0\u3051\u308B\u308F\u3051\u304C\u306A\u3044\u3060\u308D\u3046\uFF01\u3055\u3041\u6765\u3044\uFF01"
