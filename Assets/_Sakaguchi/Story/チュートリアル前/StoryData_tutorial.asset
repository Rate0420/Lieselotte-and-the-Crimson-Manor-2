  name:
  - none
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - none
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - none
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  text:
  - "\u3042\u308B\u3068\u3053\u308D\u306B\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6\u3068\u3044\u3046\u9A0E\u58EB\u304C\u5C45\u307E\u3057\u305F\u3002\\n\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6\u306F\u3042\u308B\u65E5\u4E3B\u547D\u3092\u53D7\u3051,\\n\u9818\u5730\u306E\u5916\u308C\u306B\u3042\u308B\u5947\u5999\u306A\u9928\u3092\u63A2\u7D22\u306B\u6765\u3066\u3044\u307E\u3057\u305F\u3002"
  - "\u3046\u30FC\u3093...\u9928\u306B\u5165\u3063\u305F\u307E\u3067\u306F\u826F\u3044\u304C...\\n\u8FF7\u3063\u3066\u3057\u307E\u3063\u305F\u306A..."
  - "\u8AB0\u3082\u3044\u306A\u3044\u3088\u3046\u3060\u3057\u3001\u3055\u3063\u3055\u3068\u51FA\u3066\u5E30\u308A\u305F\u3044\u306E\u3060\u304C..."
  - "\u2015\u2015\u30AC\u30B7\u30E3\u30F3\uFF01\uFF01\\n\u3059\u3050\u8FD1\u304F\u306E\u5ECA\u4E0B\u306E\u65B9\u304B\u3089\u4F55\u304B\u304C\u5272\u308C\u308B\u97F3\u304C\u3057\u305F\uFF01"
  - "\u3060\u3001\u8AB0\u3060\uFF01"
  - "\u5ECA\u4E0B\u306B\u5411\u304B\u3046\u3068\u4EBA\u5F71\u304C\u898B\u3048\u305F\u3002\\n\u3060\u304C\u751F\u6C17\u306F\u7121\u304F\u3001\u3042\u3068\u3046\u306E\u9593\u306E\u3088\u3046\u306A\u3046\u3081\u304D\u58F0\u3092\u4E0A\u3052\u3066\u3044\u308B\u3002\\n\u2015\u2015\u3053\u306E\u4E16\u306E\u3082\u306E\u3067\u306F\u306A\u3044\u3002\u305D\u3046\u601D\u3063\u305F\u3002"
  - "\u3046\u3001\u3046\u308F\u3042\u3042\u3042\u3042\uFF01\uFF01...\u3093...\u3042\u3001\u306A\u3093\u3060\u3002\u5E7D\u970A\u3067\u306F\u306A\u3044\u306E\u304B\u3002"
  - "\u5C4D\u304C\u52D5\u3044\u3066\u3044\u308B\u3068\u306F\u73CD\u5999\u3060\u304C\u3001\u7269\u7406\u653B\u6483\u304C\u901A\u308B\u306A\u3089\\n\u3053\u306E\u79C1\u306E\u6575\u3067\u306F\u306A\u3044\uFF01\u884C\u304F\u305E\uFF01\uFF01"
