  name:
  - none
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - none
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - none
  - none
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  text:
  - "\u5C4B\u6577\u306E\u63A2\u7D22\u3092\u3064\u3065\u3051\u308B\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6\u306F\u3001\\n\u4ECA\u56DE\u305F\u3069\u308A\u7740\u3044\u305F\u306E\u306F\u898B\u305F\u3053\u3068\u306E\u7121\u3044\u90E8\u5C4B\u3060\u3063\u305F\u3002"
  - "...\u3075\u3080\u3001\u4ECA\u307E\u3067\u306B\u305F\u3069\u308A\u7740\u3044\u305F\u3053\u3068\u306E\u7121\u3044\u90E8\u5C4B\u3060\u306A\u3002"
  - "\u90E8\u5C4B\u3092\u89B3\u5BDF\u3057\u3066\u3044\u308B\u3068\u3001\\n\u6697\u95C7\u306E\u5965\u304B\u3089\u30E1\u30A4\u30C9\u670D\u3092\u7740\u305F\u5973\u6027\u3089\u3057\u304D\u59FF\u304C\u898B\u3048\u308B\u3002"
  - "...\u304A\u3049\uFF01\u3064\u3044\u306B\u666E\u901A\u306E\u4EBA\u3092\u898B\u3064\u3051\u305F\u305E\uFF01\\n\u305D\u3053\u306E\u30E1\u30A4\u30C9\uFF01\u3053\u3053\u306F\u3044\u3063\u305F\u3044\u3069\u3053\u3067..."
  - "\u30E1\u30A4\u30C9\u306F\u7A81\u7136\u30CA\u30A4\u30D5\u3092\u6295\u3052\u3066\u304D\u305F\uFF01"
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6\u306F\u9593\u4E00\u9AEA\u3067\u304B\u308F\u3057\u305F\uFF01"
  - "\u5371\u306A\u30C3...\u8CB4\u69D8\u4F55\u3092\u3059\u308B\uFF01\\n...\u3088\u3001\u3088\u304F\u898B\u305F\u3089\u9996\u304B\u3089\u4E0A\u304C\u7121\u3044\u3067\u306F\u306A\u3044\u304B\uFF01\\n\u3048\u3048\u3044\u3001\u8CB4\u69D8\u3082\u5316\u3051\u7269\u3069\u3082\u306E\u4EF2\u9593\u3060\u306A\uFF01\uFF1F"
  - "\u30E1\u30A4\u30C9\u5982\u304D\u304C\u9A0E\u58EB\u306B\u6B6F\u5411\u304B\u3046\u3068\u306F\u3044\u3044\u5EA6\u80F8\u3060\u306A\uFF01\\n\u5F8C\u6094\u3059\u308B\u3053\u3068\u306B\u306A\u308B\u305E\uFF01\u3055\u3041\u6765\u3044\uFF01"
