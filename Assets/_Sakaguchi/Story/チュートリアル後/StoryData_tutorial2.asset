  name:
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - none
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - none
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6"
  text:
  - "...\u3075\u3045\u3002\u306A\u3093\u3068\u306A\u304F\u6226\u3044\u306E\u611F\u3092\u53D6\u308A\u623B\u3057\u305F\u6C17\u304C\u3059\u308B\u305E\u3002"
  - "...\u3057\u304B\u3057\u3001\u3053\u308C\u306F\u602A\u7269\u3084\u60AA\u9B54\u306E\u985E\u306E\u305B\u3044\u3067\u8FF7\u3063\u3066\u308B\u3093\u3060\u306A\u3002\\n\u3046\u3093\u3001\u304D\u3063\u3068\u305D\u3046\u306B\u9055\u3044\u306A\u3044\u3002"
  - "\u3053\u3046\u306A\u3063\u305F\u3089\u65B9\u6CD5\u306F\u4E00\u3064\u306E\u307F\uFF01\\n\u76F4\u9032\uFF01\u305D\u3057\u3066\u6BB2\u6EC5\uFF01\u3055\u3041\u3044\u304F\u305E\uFF01\uFF01"
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6\u306F\u8218\u306E\u7D42\u308F\u308A\u3092\u76EE\u6307\u3057\u3066\u4E00\u65B9\u5411\u306B\u8D70\u308A\u7D9A\u3051\u305F\u3002\\n\u6570\u5341\u5206\u5F8C\u3002"
  - "\u307E\u3001\u5168\u304F\u7AEF\u306B\u305F\u3069\u308A\u7740\u304B\u3093...\\n\u3068\u3044\u3046\u304B\u3001\u3053\u3053\u306F\u5165\u3063\u3066\u304D\u305F\u30A8\u30F3\u30C8\u30E9\u30F3\u30B9\u30DB\u30FC\u30EB\u3058\u3083\u306A\u3044\u304B..."
  - "\u3075\u3068\u90E8\u5C4B\u306E\u7AEF\u3092\u898B\u3084\u308B\u3068\u3001\\n\u30A8\u30F3\u30C8\u30E9\u30F3\u30B9\u306B\u306F\u4F3C\u3064\u304B\u308F\u3057\u304F\u306A\u3044\u7269\u304C\u93AE\u5EA7\u3057\u3066\u3044\u305F\u3002"
  - "\u3080...\u3053\u308C\u306F...\u7089\u3068\u935B\u51B6\u53F0...\u935B\u51B6\u7528\u306E\u7528\u5177\u3082...\u306A\u305C\u3053\u3093\u306A\u3068\u3053\u308D\u306B\uFF1F"
  - "\u3075\u3080...\u4F7F\u3048\u305D\u3046\u3060\u306A\u3002\\n[\u4F55\u304B\u6B66\u5668\u3092\u62FE\u3063\u305F\u3089\u30CB\u30B3\u30A4\u30C1\u3067\u65B0\u3057\u3044\u6B66\u5668\u3092\u4F5C\u308C\u308B]\u304B\u3082\u3057\u308C\u3093\u3002"
  - "\u3068\u308A\u3042\u3048\u305A\u3001\\n\u3053\u3053\u3092\u62E0\u70B9\u4EE3\u308F\u308A\u306B\u3053\u306E\u9928\u306E\u63A2\u7D22\u3092\u9032\u3081\u3066\u3044\u304F\u304B..."
