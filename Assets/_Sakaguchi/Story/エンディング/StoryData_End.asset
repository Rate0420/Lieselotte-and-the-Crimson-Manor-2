  text:
  - "\u3050\u3063...\u305D\u3093\u306A...\u3053\u3093\u306A\u7D50\u672B..."
  - "...\u304B\u3001\u52DD\u3063\u305F\uFF01\u52DD\u3063\u305F\u305E\uFF01"
  - "\u30F4\u30A7\u30EB\u30DF\u30EA\u30AA\u30F3\u306F\u3075\u3089\u3064\u304D\u306A\u304C\u3089\u3082\u3053\u3061\u3089\u3092\u898B\u3084\u308A\u3001\\n\u3075\u3068\u4E0D\u6575\u306A\u7B11\u307F\u3092\u6D6E\u304B\u3079\u308B\u3002"
  - "...\u60AA\u5922\u306F\u76EE\u899A\u3081\u306A\u3044\u308F\u3001\u79C1\u3092\u8A0E\u3063\u305F\u3068\u3057\u3066\u3082..."
  - "\u305D\u306E\u8A00\u8449\u3092\u7D21\u304E\u7D42\u3048\u308B\u524D\u306B\u3001\\n\u30F4\u30A7\u30EB\u30DF\u30EA\u30AA\u30F3\u306F\u7070\u3068\u306A\u308A\u6563\u3063\u3066\u3044\u3063\u305F\u3002"
  - "\u305D\u308C\u3068\u540C\u6642\u306B\u3001\\n\u9589\u3056\u3055\u308C\u305F\u7384\u95A2\u53E3\u304B\u3089\u98A8\u3092\u611F\u3058\u305F\u3002"
  - "...\u304A\u3001\u304A\u304A\uFF01\u6249\u304B\u3089\u5149\u304C\uFF01\u3084\u3063\u3068\u5E30\u308C\u308B\uFF01"
  - "\u307E\u305F\u5999\u306A\u3053\u3068\u304C\u8D77\u304D\u308B\u524D\u306B\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6\u306F\\n\u6249\u306B\u99C6\u3051\u5BC4\u308A\u3001\u5916\u306B\u51FA\u305F\u3002"
  - "\u8131\u51FA\u306E\u611F\u52D5\u3092\u3072\u3068\u3057\u304D\u308A\u5473\u308F\u3063\u305F\u5F8C\u3001\\n\u632F\u308A\u3080\u3044\u3066\u307F\u308B\u3068\u305D\u3053\u306B\u9928\u306F\u7121\u304F\u3001\\n\u305F\u3060\u9B31\u84BC\u3068\u3057\u305F\u68EE\u304C\u5E83\u304C\u308B\u3070\u304B\u308A\u3067\u3042\u3063\u305F\u3002"
  - "...\u5831\u544A\u306F\u3069\u3046\u3057\u305F\u3089\u3088\u3044\u306E\u3060\u308D\u3046\u304B..."
  - "\u30EA\u30FC\u30BC\u30ED\u30C3\u30C6\u306F\u305D\u3093\u306A\u3053\u3068\u3092\u601D\u6848\u3057\u306A\u304C\u3089\\n\u4E3B\u306E\u3082\u3068\u3078\u5E30\u308A\u59CB\u3081\u305F\u3002"
  - "\u7D42"
  - "\u2015\u2015\u2015\u7D42"
  - "\u7E5D\u5F8C\u039E\u2015\u2015\u7D42"
  - "\u7E5D\u5F8C\u039E\u7E5D\uFF6A\u7E67\uFF77\u7E5D\uFF63\u2015\u3089\u306A\u3044\u3002"
  - "\u2015\u2015\u2015\u60AA\u5922\u306F\u3001\u7D42\u308F\u3089\u306A\u3044"
  - "\u2015\u2015\u2015...\u826F\u3044\u5922\u306F\u898B\u308C\u305F\u304B\u3057\u3089\uFF1F"
  - "...\u672C\u5F53\u306B\u7D42\u308F\u308A\u3002"
