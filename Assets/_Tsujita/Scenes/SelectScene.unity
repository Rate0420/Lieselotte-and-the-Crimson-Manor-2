--- !u!114 &289632360
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 289632357}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c938d94d5932239429587864319f794a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  introduction:
  - "\u306F\u305A\u308C"
  - "\u2014\u2014\u72FC\u3068\u4EBA\u306E\u6DF7\u8840\u306E\u95D8\u58EB\u3002\u200B\u305D\u306E\u982D\u306E\u4E2D\u306F\u304A\u304A\u3088\u305D\u30D2\u30C8\u3067\u306F\u306A\u304F\u7363\u306E\u305D\u308C\u3067\u3042\u308A\u3001\u6B66\u5668\u3092\u632F\u308B\u601D\u8003\u306F\u7121\u304F\u3001\u305F\u3060\u722A\u3068\u7259\u3067\u7372\u7269\u3092\u72E9\u308B\u306E\u307F\u3067\u3042\u308B\u3002\u200B\u304B\u3064\u3066\u306F\u7406\u6027\u304C\u3042\u3063\u305F\u306E\u304B\u3001\u6C5A\u308C\u305F\u93A7\u3092\u7740\u3066\u3044\u308B\u3002\u3057\u304B\u3057\u305D\u306E\u76EE\u306F\u9EC4\u8272\u304F\u5149\u308A\u3001\u91CE\u751F\u306E\u672C\u80FD\u306B\u5451\u307E\u308C\u3066\u3044\u308B\u306E\u3060\u3002\u2014\u2014"
  - "\u2014\u2014\u7D05\u304D\u8759\u8760\u306E\u7FFC\u3092\u7E2B\u3044\u4ED8\u3051\u3089\u308C\u305F\u3001\u54C0\u308C\u306A\u72E9\u4EBA\u3002\u304B\u3064\u3066\u4EBA\u9593\u3067\u3042\u3063\u305F\u8005\u304C\u3001\u9928\u306E\u4E3B\u306B\u9B45\u5165\u3089\u308C\u3001\u7737\u5C5E\u3068\u3057\u3066\u4ED5\u3048\u308B\u8EAB\u3078\u3068\u5815\u3061\u305F\u3002\u305D\u306E\u65A7\u3092\u632F\u308B\u3046\u59FF\u306F\u7C97\u91CE\u306B\u898B\u3048\u3066\u3001\u3069\u3053\u304B\u8A87\u308A\u9AD8\u304D\u6226\u58EB\u306E\u9762\u5F71\u3092\u6B8B\u3057\u3066\u3044\u308B\u3002\u305D\u306E\u773C\u306B\u6620\u308B\u306E\u306F\u3001\u8840\u3078\u306E\u6E07\u671B\u304B\u3001\u305D\u308C\u3068\u3082\u4E3B\u3078\u306E\u5FE0\u8AA0\u304B\u2014\u2014 "
  - "\u2014\u2014\u9996\u3092\u5931\u3044\u306A\u304C\u3089\u3082\u306A\u304A\u3001\u4E3B\u3078\u306E\u5949\u4ED5\u3092\u3084\u3081\u306C\u54C0\u3057\u304D\u5F93\u50D5\u3002\u200B\u305D\u306E\u52D5\u304D\u306F\u7A32\u59BB\u306E\u5982\u304F\u901F\u304F\u3001\u4E8C\u632F\u308A\u306E\u30CA\u30A4\u30D5\u304C\u7A7A\u3092\u88C2\u304F\u305F\u3073\u3001\u8840\u98DB\u6CAB\u304C\u54B2\u304F\u3002\u200B\u6575\u306E\u547D\u3092\u5208\u308A\u53D6\u308B\u305F\u3073\u3001\u5F7C\u5973\u306F\u7A7A\u865A\u306A\u793C\u3092\u3059\u308B\u200B\u3002\u307E\u308B\u3067\u201C\u9996\u306E\u306A\u3044\u307E\u307E\u982D\u3092\u4E0B\u3052\u308B\u201D\u3053\u3068\u306B\u6163\u308C\u304D\u3063\u3066\u3044\u308B\u304B\u306E\u3088\u3046\u306B\u3002\u2014\u2014\u200B"
  - "\u2014\u2014\u89D2\u706F\u3092\u982D\u306B\u6234\u304F\u3001\u5C4B\u6577\u306E\u5B88\u8B77\u8005\u3002\u200B\u8840\u3068\u7070\u306B\u5857\u308C\u305F\u5916\u5957\u304C\u3001\u305D\u306E\u5E7E\u5343\u306E\u6226\u3044\u3092\u7269\u8A9E\u308B\u3002\u200B\u63FA\u3089\u3081\u304F\u708E\u306E\u5965\u306B\u3001\u304B\u3059\u304B\u306B\u4EBA\u306E\u77B3\u304C\u898B\u3048\u308B\u6C17\u304C\u3057\u305F\u3002\u200B\u5DE8\u5927\u306A\u5263\u3092\u7247\u624B\u306B\u63B2\u3052\u3001\u9759\u304B\u306B\u7ACB\u3064\u305D\u306E\u59FF\u306F\u3001\u3082\u306F\u3084\u5100\u5F0F\u306E\u4E00\u90E8\u306E\u3088\u3046\u3060\u3002\u200B\u5F7C\u306E\u706F\u706B\u304C\u6D88\u3048\u308B\u3068\u304D\u3001\u9928\u306E\u95C7\u304C\u3044\u3063\u305D\u3046\u6DF1\u304F\u306A\u308B\u3002\u2014\u2014"
  - "\u2014\u2014\u9928\u306E\u4E3B\u306B\u3057\u3066\u3001\u6B8B\u9177\u304B\u3064\u83EF\u9E97\u3067\u7F8E\u3057\u304D\u3001\u201C\u7D05\u306E\u591C\u201D\u3092\u53F8\u308B\u5438\u8840\u9B3C\u3002\u305D\u306E\u821E\u8E0F\u306E\u3088\u3046\u306A\u52D5\u304D\u306F\u3001\u6B8B\u9177\u3055\u3068\u512A\u96C5\u3055\u3092\u540C\u6642\u306B\u5BBF\u3059\u3002\u200B\u305D\u306E\u4E00\u6483\u4E00\u6483\u304C\u3001\u307E\u308B\u3067\u82B1\u5F01\u306E\u3088\u3046\u306B\u9BAE\u70C8\u306A\u8840\u3092\u54B2\u304B\u305B\u308B\u3002\u200B\u305D\u306E\u7D05\u306E\u773C\u304C\u8F1D\u304F\u3068\u304D\u3001\u591C\u304C\u9707\u3048\u3001\u8840\u306E\u5BB4\u304C\u59CB\u307E\u308B\u3002\u305D\u3057\u3066\u591C\u306F\u3001\u30F4\u30A7\u30EB\u30DF\u30EA\u30AA\u30F3\u306E\u540D\u3068\u5171\u306B\u7D05\u304F\u67D3\u307E\u308B\u306E\u3060\u2014\u2014"
  enemyName:
  - "\u306F\u305A\u308C"
  - "\u72FC\u4EBA\u95D8\u58EB"
